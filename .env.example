# CoastWatch environment template.
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is gitignored).

# --- Application ---
PROJECT_NAME=CoastWatch
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Logging ---
# console | json
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL + TimescaleDB + PostGIS) ---
POSTGRES_USER=coastwatch
POSTGRES_PASSWORD=coastwatch
POSTGRES_DB=coastwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full override; if set it takes precedence over the parts above.
# DATABASE_URL=postgresql+psycopg2://coastwatch:coastwatch@localhost:5432/coastwatch

# --- Domain defaults ---
DEFAULT_TIMEZONE=Asia/Manila
MODEL_PATH=./ml/models
DATA_DIR=./data

# --- Retained tide-aware baseline gates (no predictor feeds them) ---
TIDE_SLACK_SLOPE_TOLERANCE_M_PER_HOUR=0.01
TIDE_EXTREMA_PROMINENCE_M=0.05

# --- Phase 7: in-process live capture / test lab (optional) ---
# Autostart is opt-in so importing the app never opens a real stream/device.
# The worker samples ONE frame and runs ONE inference per interval; the preview
# endpoint only serves that cached frame.
LIVE_CAPTURE_AUTOSTART=false
LIVE_CAPTURE_INTERVAL_SECONDS=30
# Lower bound for preview cache freshness; effective value is at least
# 2.5 x LIVE_CAPTURE_INTERVAL_SECONDS.
PREVIEW_CACHE_MAX_AGE_SECONDS=60
# ONNX Runtime intra-op threads (0 = ORT default).
ONNX_INTRA_OP_THREADS=0
# Process-wide CPU inference cap across all camera workers.
ONNX_MAX_CONCURRENT_INFERENCES=1
LAB_MAX_CONCURRENT_RUNS=2
LAB_RUN_TTL_SECONDS=21600
LAB_MAX_IMAGES=50
LAB_MAX_IMAGE_BYTES=10485760
LAB_MAX_TOTAL_UPLOAD_BYTES=41943040
LAB_MAX_VIDEO_UPLOAD_BYTES=209715200
LAB_MAX_VIDEO_SAMPLES=120
LAB_MAX_STREAM_SAMPLES=60
LAB_MAX_STREAM_SECONDS=600

# --- Frontend (inlined at build time by Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Displayed in experimental rolling-baseline warnings; set per deployment.
# NEXT_PUBLIC_OFFICIAL_WARNING_AUTHORITY=the official national tsunami warning authority
